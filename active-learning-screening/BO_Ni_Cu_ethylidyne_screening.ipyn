    "from huggingface_hub import login\n",
    "\n",
    "login()  # will prompt for your token interactively\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Get input structures\n",
    "\n",
    "If you're running this in Colab, either:\n",
    "- clone this repo (so `data/NiPOSCAR_SD.vasp` and `data/POSCAR_CCH3.vasp` are available), or\n",
    "- upload your own POSCAR files with the file picker below.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "REPO_URL = \"https://github.com/sba340/YOUR-REPO-NAME.git\"  # <-- update after you create the repo\n",
    "\n",
    "if not os.path.exists(\"data\"):\n",
    "    !git clone -q {REPO_URL} repo_tmp && mv repo_tmp/data . && rm -rf repo_tmp\n",
    "\n",
    "SLAB_PATH = \"data/NiPOSCAR_SD.vasp\"\n",
    "ADSORBATE_PATH = \"data/POSCAR_CCH3.vasp\"\n",
    "\n",
    "# Alternative: upload manually in Colab instead of cloning\n",
    "# from google.colab import files\n",
    "# uploaded = files.upload()\n",
    "# SLAB_PATH = \"NiPOSCAR_SD.vasp\"\n",
    "# ADSORBATE_PATH = \"POSCAR_CCH3.vasp\"\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import random\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "\n",
    "from ase.constraints import FixAtoms\n",
    "from ase.io import read, write\n",
    "from ase.neighborlist import NeighborList, natural_cutoffs\n",
    "from ase.optimize import LBFGS\n",
    "\n",
    "from botorch.acquisition import LogExpectedImprovement\n",
    "from botorch.fit import fit_gpytorch_mll\n",
    "from botorch.models import SingleTaskGP\n",
    "from botorch.optim import optimize_acqf\n",
    "from gpytorch.mlls import ExactMarginalLogLikelihood\n",
    "\n",
    "from sklearn.cluster import KMeans\n",
    "\n",
    "from fairchem.core import FAIRChemCalculator, pretrained_mlip\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Setup: output dirs, device, load structures, ML potential"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "\n",
    "os.makedirs(\"bo_structures\", exist_ok=True)\n",
    "os.makedirs(\"bo_trajectories\", exist_ok=True)\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"Using device: {device}\")\n",
    "\n",
    "atoms = read(SLAB_PATH)\n",
    "adsorbate = read(ADSORBATE_PATH)\n",
    "\n",
    "print(\"Loading FAIRChem UMA model...\")\n",
    "predictor = pretrained_mlip.get_predict_unit(\"uma-s-1\", device=str(device))\n",
    "calc = FAIRChemCalculator(predictor, task_name=\"oc20\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Identify fixed (bottom) slab layers via k-means clustering on z-coordinate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =========================\n",
    "# FIXED LAYERS\n",
    "# =========================\n",
    "z = np.array([[a.position[2]] for a in atoms])\n",
    "kmeans = KMeans(n_clusters=5, random_state=0).fit(z)\n",
    "labels = kmeans.labels_\n",
    "\n",
    "layer_means = [(i, z[labels == i].mean()) for i in range(5)]\n",
    "sorted_layers = sorted(layer_means, key=lambda x: x[1])\n",
    "bottom = [sorted_layers[0][0], sorted_layers[1][0]]\n",
    "fixed_indices = [i for i, l in enumerate(labels) if l in bottom]\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Reference gas-phase adsorbate energy (computed once)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =========================\n",
    "# GAS ENERGY (compute once)\n",
    "# =========================\n",
    "gas = adsorbate.copy()\n",
    "gas.calc = calc\n",
    "gas_e = gas.get_potential_energy()\n",
    "print(f\"Gas phase CCH3 energy: {gas_e:.4f} eV\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Physical sanity checks: dissociation / desorption detection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def check_dissociation(initial_ads, final_ads):\n",
    "    try:\n",
    "        initial_nl = NeighborList(natural_cutoffs(initial_ads), self_interaction=False, bothways=True)\n",
    "        initial_nl.update(initial_ads)\n",
    "        final_nl = NeighborList(natural_cutoffs(final_ads), self_interaction=False, bothways=True)\n",
    "        final_nl.update(final_ads)\n",
    "        for i in range(len(initial_ads)):\n",
    "            if set(initial_nl.get_neighbors(i)[0]) != set(final_nl.get_neighbors(i)[0]):\n",
    "                return True\n",
    "        return False\n",
    "    except Exception:\n",
    "        return True\n",
    "\n",
    "\n",
    "def check_desorption(system, n_slab_atoms, cushion=1.5):\n",
    "    try:\n",
    "        cutoffs = [c * cushion for c in natural_cutoffs(system)]\n",
    "        nl = NeighborList(cutoffs, self_interaction=False, bothways=True)\n",
    "        nl.update(system)\n",
    "        for ads_idx in range(n_slab_atoms, len(system)):\n",
    "            neighbors = nl.get_neighbors(ads_idx)[0]\n",
    "            if any(n < n_slab_atoms for n in neighbors):\n",
    "                return False\n",
    "        return True\n",
    "    except Exception:\n",
    "        return True\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Structure builder: random Ni\u2192Cu substitution + adsorbate placement"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_system(seed, site_type):\n",
    "    seed = int(seed)\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "\n",
    "    slab = atoms.copy()\n",
    "\n",
    "    ni_indices = [i for i, a in enumerate(slab) if a.symbol == \"Ni\"]\n",
    "    random.shuffle(ni_indices)\n",
    "    cu_indices = ni_indices[:18]\n",
    "    for i in cu_indices:\n",
    "        slab[i].symbol = \"Cu\"\n",
    "\n",
    "    surface_z = max(a.position[2] for a in slab)\n",
    "    surface_atoms = [i for i, a in enumerate(slab)\n",
    "                     if abs(a.position[2] - surface_z) < 0.5]\n",
    "\n",
    "    if site_type == \"ontop\":\n",
    "        idx = random.choice(surface_atoms)\n",
    "        site_pos = slab[idx].position.copy()\n",
    "    elif site_type == \"bridge\":\n",
    "        i1 = random.choice(surface_atoms)\n",
    "        dists = [(j, np.linalg.norm(slab[j].position[:2] - slab[i1].position[:2]))\n",
    "                 for j in surface_atoms if j != i1]\n",
    "        i2 = min(dists, key=lambda x: x[1])[0]\n",
    "        site_pos = (slab[i1].position + slab[i2].position) / 2\n",
    "    elif site_type == \"hollow\":\n",
    "        i1 = random.choice(surface_atoms)\n",
    "        dists = sorted([(j, np.linalg.norm(slab[j].position[:2] - slab[i1].position[:2]))\n",
    "                        for j in surface_atoms if j != i1], key=lambda x: x[1])\n",
    "        i2, i3 = dists[0][0], dists[1][0]\n",
    "        site_pos = (slab[i1].position + slab[i2].position + slab[i3].position) / 3\n",
    "    else:\n",
    "        idx = random.choice(surface_atoms)\n",
    "        site_pos = slab[idx].position.copy()\n",
    "\n",
    "    ads = adsorbate.copy()\n",
    "    ads.translate(-ads.get_center_of_mass())\n",
    "    ads.rotate(random.uniform(0, 2 * np.pi), 'z')\n",
    "    ads.translate(site_pos + np.array([0, 0, 2.0]))\n",
    "\n",
    "    return slab + ads, slab\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Evaluator: relax with the ML potential and compute adsorption energy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "site_map = {0: \"ontop\", 1: \"bridge\", 2: \"hollow\"}\n",
    "\n",
    "\n",
    "def get_final_site(system, n_slab_atoms):\n",
    "    \"\"\"Determine final adsorption site by counting unique slab neighbors of the anchor C atom.\"\"\"\n",
    "    try:\n",
    "        cutoffs = [c * 1.5 for c in natural_cutoffs(system)]\n",
    "        nl = NeighborList(cutoffs, self_interaction=False, bothways=True)\n",
    "        nl.update(system)\n",
    "        c_idx = n_slab_atoms  # C is the first adsorbate atom\n",
    "        slab_neighbors = [n for n in nl.get_neighbors(c_idx)[0] if n < n_slab_atoms]\n",
    "        n = len(slab_neighbors)\n",
    "        if n == 1:\n",
    "            return \"ontop\"\n",
    "        elif n == 2:\n",
    "            return \"bridge\"\n",
    "        elif n >= 3:\n",
    "            return \"hollow\"\n",
    "        else:\n",
    "            return \"unknown\"\n",
    "    except Exception:\n",
    "        return \"unknown\"\n",
    "\n",
    "\n",
    "def evaluate_torch(x, step_label=\"eval\"):\n",
    "    seed = int(round(x[0].item()))\n",
    "    site_type = site_map[int(round(x[1].item() * 2))]\n",
    "\n",
    "    system, slab = build_system(seed, site_type)\n",
    "    n_slab = len(slab)\n",
    "    initial_ads = system[n_slab:].copy()\n",
    "\n",
    "    system.set_constraint(FixAtoms(indices=fixed_indices))\n",
    "    system.calc = calc\n",
    "\n",
    "    traj_path = f\"bo_trajectories/{step_label}_seed{seed}_{site_type}.traj\"\n",
    "    try:\n",
    "        opt = LBFGS(system, trajectory=traj_path, logfile=None)\n",
    "        opt.run(fmax=0.05, steps=300)\n",
    "    except Exception as e:\n",
    "        print(f\"  Relaxation failed: {e}\")\n",
    "        return torch.tensor([[1e5]], dtype=torch.double, device=device), None, None, site_type, False, \"unknown\"\n",
    "\n",
    "    final_ads = system[n_slab:].copy()\n",
    "\n",
    "    if check_dissociation(initial_ads, final_ads):\n",
    "        print(f\"  Seed {seed} {site_type}: DISSOCIATED - skipping\")\n",
    "        return torch.tensor([[1e5]], dtype=torch.double, device=device), None, None, site_type, False, \"unknown\"\n",
    "\n",
    "    if check_desorption(system, n_slab):\n",
    "        print(f\"  Seed {seed} {site_type}: DESORBED - skipping\")\n",
    "        return torch.tensor([[1e5]], dtype=torch.double, device=device), None, None, site_type, False, \"unknown\"\n",
    "\n",
    "    slab_only = slab.copy()\n",
    "    slab_only.set_constraint(FixAtoms(indices=fixed_indices))\n",
    "    slab_only.calc = calc\n",
    "    e_slab = slab_only.get_potential_energy()\n",
    "\n",
    "    e_total = system.get_potential_energy()\n",
    "    e_ads = e_total - e_slab - gas_e\n",
    "\n",
    "    final_site = get_final_site(system, n_slab)\n",
    "    print(f\"  Seed {seed} init={site_type} -> final={final_site}: E_ads = {e_ads:.4f} eV\")\n",
    "    return torch.tensor([[-e_ads]], dtype=torch.double, device=device), system.copy(), e_ads, site_type, True, final_site\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Checkpointing helpers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def save_checkpoint(train_x, train_y, results, step):\n",
    "    torch.save({\"train_x\": train_x.cpu(), \"train_y\": train_y.cpu()}, \"bo_checkpoint.pt\")\n",
    "    with open(\"bo_checkpoint_meta.json\", \"w\") as f:\n",
    "        json.dump({\"step\": step, \"results\": results}, f, indent=2)\n",
    "    print(f\"  Checkpoint saved at step {step}\")\n",
    "\n",
    "\n",
    "def load_checkpoint():\n",
    "    if os.path.exists(\"bo_checkpoint.pt\") and os.path.exists(\"bo_checkpoint_meta.json\"):\n",
    "        ckpt = torch.load(\"bo_checkpoint.pt\")\n",
    "        with open(\"bo_checkpoint_meta.json\") as f:\n",
    "            meta = json.load(f)\n",
    "        print(f\"  Resuming from step {meta['step'] + 1}\")\n",
    "        return ckpt[\"train_x\"].to(device), ckpt[\"train_y\"].to(device), meta[\"results\"], meta[\"step\"] + 1\n",
    "    return None\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Search-space bounds and normalization\n",
    "\n",
    "`x[0]` is the random seed (controls Cu-substitution pattern), `x[1]` maps to the site type (on-top / bridge / hollow)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "bounds = torch.tensor([\n",
    "    [0.0, 0.0],\n",
    "    [1.0, 1.0]\n",
    "], dtype=torch.double, device=device)\n",
    "\n",
    "\n",
    "def normalize(x):\n",
    "    raw_bounds_low = torch.tensor([0.0, 0.0], dtype=torch.double, device=device)\n",
    "    raw_bounds_high = torch.tensor([100.0, 1.0], dtype=torch.double, device=device)\n",
    "    return (x - raw_bounds_low) / (raw_bounds_high - raw_bounds_low)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 13. Initialize (or resume) the BO run"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "checkpoint = load_checkpoint()\n",
    "if checkpoint is not None:\n",
    "    train_x, train_y, results, start_step = checkpoint\n",
    "    best_energy = min((r[\"energy\"] for r in results if r[\"energy\"] is not None), default=float(\"inf\"))\n",
    "    best_structure = None  # cannot recover an ASE object from the checkpoint file\n",
    "    best_meta = None\n",
    "    print(f\"  Best energy so far: {best_energy:.4f} eV\")\n",
    "else:\n",
    "    start_step = 0\n",
    "    results = []\n",
    "    best_energy = float(\"inf\")\n",
    "    best_structure = None\n",
    "    best_meta = None\n",
    "\n",
    "    print(\"\\nEvaluating initial points...\")\n",
    "    train_x = torch.tensor([\n",
    "        [1, 0.0],\n",
    "        [2, 0.5],\n",
    "        [3, 1.0],\n",
    "        [4, 0.0],\n",
    "        [5, 0.5]\n",
    "    ], dtype=torch.double, device=device)\n",
    "\n",
    "    train_y_list = []\n",
    "    for x in train_x:\n",
    "        y, _, _, _, _, _ = evaluate_torch(x, step_label=\"init\")\n",
    "        train_y_list.append(y)\n",
    "    train_y = torch.cat(train_y_list)\n",
    "    save_checkpoint(train_x, train_y, results, step=-1)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 14. Fit the initial Gaussian Process surrogate model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model = SingleTaskGP(normalize(train_x).cpu(), train_y.cpu())\n",
    "mll = ExactMarginalLogLikelihood(model.likelihood, model)\n",
    "fit_gpytorch_mll(mll)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 15. Bayesian optimization loop\n",
    "\n",
    "Each step: pick the next candidate via Expected Improvement, relax it with the ML potential, update the GP, and checkpoint. `N_BO_STEPS` controls the total budget."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "N_BO_STEPS = 20  # total number of BO iterations to run\n",
    "\n",
    "for i in range(start_step, N_BO_STEPS):\n",
    "    print(f\"\\n--- BO Step {i} ---\")\n",
    "    EI = LogExpectedImprovement(model=model, best_f=train_y.cpu().max())\n",
    "    new_x_norm, _ = optimize_acqf(\n",
    "        acq_function=EI,\n",
    "        bounds=bounds.cpu(),\n",
    "        q=1,\n",
    "        num_restarts=10,\n",
    "        raw_samples=50,\n",
    "    )\n",
    "    raw_bounds_high = torch.tensor([100.0, 1.0], dtype=torch.double)\n",
    "    new_x_raw = (new_x_norm * raw_bounds_high).to(device)\n",
    "\n",
    "    y, relaxed_system, e_ads, site, passed, final_site = evaluate_torch(new_x_raw[0], step_label=f\"step{i}\")\n",
    "\n",
    "    train_x = torch.cat([train_x, new_x_raw.to(device)])\n",
    "    train_y = torch.cat([train_y, y.to(device)])\n",
    "\n",
    "    if passed and e_ads < best_energy:\n",
    "        best_energy = e_ads\n",
    "        best_structure = relaxed_system\n",
    "        best_meta = {\"step\": i, \"seed\": int(new_x_raw[0, 0].item()), \"initial_site\": site,\n",
    "                     \"final_site\": final_site, \"energy\": e_ads}\n",
    "        write(f\"bo_structures/best_step{i}_seed{int(new_x_raw[0,0].item())}_init{site}_final{final_site}_{e_ads:.4f}eV.vasp\",\n",
    "              relaxed_system, format='vasp', vasp5=True, sort=True)\n",
    "        print(f\"  New best: {best_energy:.4f} eV (init={site} -> final={final_site}) - saved to bo_structures/\")\n",
    "\n",
    "    if passed and relaxed_system is not None:\n",
    "        write(f\"bo_structures/step{i}_seed{int(new_x_raw[0,0].item())}_init{site}_final{final_site}_{e_ads:.4f}eV.vasp\",\n",
    "              relaxed_system, format='vasp', vasp5=True, sort=True)\n",
    "\n",
    "    results.append({\n",
    "        \"step\": i,\n",
    "        \"seed\": int(new_x_raw[0, 0].item()),\n",
    "        \"initial_site\": site,\n",
    "        \"final_site\": final_site,\n",
    "        \"energy\": e_ads if passed else None,\n",
    "        \"passed\": passed,\n",
    "    })\n",
    "\n",
    "    save_checkpoint(train_x, train_y, results, step=i)\n",
    "\n",
    "    model = SingleTaskGP(normalize(train_x).cpu(), train_y.cpu())\n",
    "    mll = ExactMarginalLogLikelihood(model.likelihood, model)\n",
    "    fit_gpytorch_mll(mll)\n",
    "\n",
    "    valid = train_y[train_y < 1e5]\n",
    "    print(f\"  Step {i}: best valid energy = {-valid.max().item():.4f} eV\" if len(valid) else \"  No valid configs yet\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 16. Save final results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.DataFrame(results)\n",
    "df.to_csv(\"bo_results.csv\", index=False)\n",
    "\n",
    "if best_structure is not None:\n",
    "    write(\"BEST_STRUCTURE.vasp\", best_structure, format='vasp', vasp5=True, sort=True)\n",
    "    print(f\"  Best structure: step={best_meta['step']} seed={best_meta['seed']} \"\n",
    "          f\"init={best_meta['initial_site']} -> final={best_meta['final_site']} E_ads={best_meta['energy']:.4f} eV\")\n",
    "\n",
    "print(\"\\nDONE\")\n",
    "print(\"- bo_results.csv\")\n",
    "print(\"- BEST_STRUCTURE.vasp\")\n",
    "print(\"- bo_structures/   (all relaxed structures)\")\n",
    "print(\"- bo_trajectories/ (LBFGS trajectory files)\")\n",
    "print(\"- bo_checkpoint.pt + bo_checkpoint_meta.json\")\n"
   ]
  }
